@{
    ViewData["Title"] = "Create / Edit";
}

@model SpendSmart.Models.Expense

<div class="text-center">
    <h1 class="display-4">Create or edit an expense</h1>
</div>

<form method="post" asp-action="CreateEditExpenseForm" asp-controller="Home">
    <label>Id</label>
    <input class="form-control" required type="number" placeholder="0" asp-for="Id"/>
    
    <label class="mt-4">Value DKK</label>
    <input class="form-control" required type="number" placeholder="0" asp-for="Value" step="0.01"/>
    
    <label class="mt-4">Description</label>
    <input class="form-control" type="text" asp-for="Description"/>
    
    <button class="btn btn-primary" class="mt-4" type="submit">OK</button>
</form>
